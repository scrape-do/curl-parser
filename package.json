{
  "name": "@scrape-do/curl-parser",
  "version": "0.4.4",
  "description": "Parse and serialize curl commands into JavaScript objects",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
