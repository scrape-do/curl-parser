    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/scrape-do/curl-parser/issues"
  },
  "homepage": "https://github.com/scrape-do/curl-parser#readme",
  "packageManager": "pnpm@12.6.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
